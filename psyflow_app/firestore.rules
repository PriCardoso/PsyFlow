rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Usuários só leem/editam o próprio perfil
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == uid;
    }

    // mood_entries — paciente cria; qualquer usuário autenticado pode ler
    // (o controle de quem é psicólogo vinculado é feito no app, não na regra,
    //  pois o Firestore não suporta query por campo em funções auxiliares com auto-ID)
    match /mood_entries/{docId} {
      allow create: if request.auth.uid == request.resource.data.patient_id;
      allow read: if request.auth != null;
      allow update, delete: if request.auth.uid == resource.data.patient_id;
    }

    // tasks — psicólogo escreve; paciente lê os próprios
    match /tasks/{docId} {
      allow read: if request.auth.uid == resource.data.patient_id
                  || request.auth.uid == resource.data.psychologist_id;
      allow create, update, delete: if request.auth.uid == resource.data.psychologist_id
                                      || request.auth.uid == request.resource.data.psychologist_id;
    }

    // therapist_patient_links — novo sistema de vínculo (TherapistPatientService)
    match /therapist_patient_links/{docId} {
      // Psicólogo cria vínculo (status: pending, patientId: null)
      allow create: if request.auth.uid == request.resource.data.psychologistId
                      && request.resource.data.patientId == null
                      && request.resource.data.status == 'pending';
      // Psicólogo lê seus próprios vínculos; paciente lê vínculos onde aparece
      allow read: if request.auth.uid == resource.data.psychologistId
                    || request.auth.uid == resource.data.patientId
                    || (resource.data.patientId == null && resource.data.status == 'pending');
      // Paciente aceita um vínculo pendente; psicólogo muda status
      allow update: if (resource.data.patientId == null
                        && resource.data.status == 'pending'
                        && request.resource.data.status == 'active'
                        && request.resource.data.patientId == request.auth.uid)
                      || (request.auth.uid == resource.data.psychologistId
                          && (request.resource.data.status == 'active'
                              || request.resource.data.status == 'inactive'));
    }

    // invites — sistema legado (InviteService)
    match /invites/{docId} {
      allow create: if request.auth.uid == request.resource.data.psychologist_id;
      allow read: if request.auth != null;
      allow update: if request.auth != null; // paciente marca como usado
    }

    // links — sistema legado de vínculos (InviteService)
    match /links/{docId} {
      allow read: if request.auth.uid == resource.data.psychologist_id
                  || request.auth.uid == resource.data.patient_id;
      allow create: if request.auth != null;
      allow update: if request.auth.uid == resource.data.psychologist_id
                    || request.auth.uid == resource.data.patient_id;
    }

    // appointments
    match /appointments/{docId} {
      allow read: if request.auth.uid == resource.data.patient_id
                  || request.auth.uid == resource.data.psychologist_id;
      allow create: if request.auth != null;
      allow update: if request.auth.uid == resource.data.patient_id
                  || request.auth.uid == resource.data.psychologist_id;
    }

    // availability_slots — psicólogo gerencia os próprios; paciente pode reservar
    match /availability_slots/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth.uid == resource.data.psychologist_id;
    }

    // Coleções de leitura pública autenticada
    match /intervention_templates/{docId} {
      allow read: if request.auth != null;
      allow write: if false; // só via console/admin
    }

    match /journey_steps/{docId} {
      allow read: if request.auth != null;
    }

    // Logs e progresso — paciente escreve/lê os próprios
    match /emotional_logs/{docId} {
      allow read, write: if request.auth.uid == resource.data.patient_id
                         || request.auth.uid == request.resource.data.patient_id;
    }

    match /patient_intervention_progress/{docId} {
      allow read, write: if request.auth != null;
    }

    match /ai_recommendations/{docId} {
      allow read, write: if request.auth != null;
    }

    match /password_reset_codes/{docId} {
      allow read, write: if request.auth != null;
    }

    // initial_assessments — paciente cria/edita a própria; psicólogo lê
    match /initial_assessments/{docId} {
      allow create, update: if request.auth.uid == request.resource.data.patient_id;
      allow read: if request.auth != null; // psicólogo vinculado lê no app
    }

    // clinical_scale_responses — paciente/psicólogo cria; psicólogo lê
    match /clinical_scale_responses/{docId} {
      allow create: if request.auth.uid == request.resource.data.patient_id
                    || request.auth.uid == request.resource.data.professionalId;
      allow read: if request.auth != null;
      allow update, delete: if request.auth.uid == resource.data.professionalId;
    }

    // clinical_sessions — psicólogo cria e edita; paciente lê as suas
    match /clinical_sessions/{docId} {
      allow create, update: if request.auth.uid == request.resource.data.professionalId;
      allow read: if request.auth.uid == resource.data.patient_id
                  || request.auth.uid == resource.data.professionalId;
      allow delete: if request.auth.uid == resource.data.professionalId;
    }

    // chat_messages — participante lê/escreve mensagens do próprio chat
    match /chats/{chatId}/messages/{msgId} {
      allow read, write: if request.auth != null;
    }

    match /chats/{chatId} {
      allow read, write: if request.auth != null;
    }
  }
}
